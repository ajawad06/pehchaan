# Pehchaan — frontend environment
# Copy to .env and fill in. Never commit the real .env (it is gitignored).
#
# Note: anything prefixed VITE_ is bundled into the browser build and is
# therefore PUBLIC. Never put a secret here. The Groq key lives on the backend
# for exactly this reason.

# Backend API base URL. Leave blank for local development — the app falls back
# to http://127.0.0.1:8000 on its own. Set this to the deployed API for builds.
VITE_API_URL=
