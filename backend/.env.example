# Pehchaan — backend environment
# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# ─── Groq (required for LLM scoring, ranking and explanations) ───────────────
# Free key from https://console.groq.com/keys
# Without it the API still runs: /score returns neutral 0.5 scores, /rank falls
# back to deterministic taxonomy order, and /explain returns templated text.
GROQ_API_KEY=

# Model used for every LLM call. Overridable because model names get retired.
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Firebase Admin (optional) ──────────────────────────────────────────────
# The whole service-account JSON on ONE line. Only needed if the backend starts
# verifying tokens or writing Firestore — today the frontend does that directly,
# so leaving this blank is fine.
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
FIREBASE_CREDENTIALS=
